# Gnani API key: create one at https://app.gnani.ai/voice
GNANI_API_KEY=

# Speech-to-text model: prisma-v3.0 (supports auto language detection) or prisma-v2.5
STT_MODEL=prisma-v3.0
# Text-to-speech model
TTS_MODEL=timbre-v2.5

# Reasoning LLM (Gnani's Evon v3.3 is not on the API yet).
# LLM_PROVIDER = gemini | anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-flash-lite-latest,gemini-3.8-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: personal data.gov.in key for live mandi prices (https://data.gov.in -> sign up -> My Account -> API key)
DATA_GOV_API_KEY=
